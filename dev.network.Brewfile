cask_args appdir: "/Applications", require_sha: true

# Analysis
brew "nmap" # Port scanning utility for large networks | https://nmap.org
brew "wireshark" # Network analyzer and capture tool - without graphical user interface | https://www.wireshark.org
cask "wireshark-app" # Network protocol analyzer | https://www.wireshark.org/
brew "tcpdump" # Command-line packet analyzer | https://www.tcpdump.org/ https://github.com/the-tcpdump-group/tcpdump

# Diagnostics
brew "doggo" # Command-line DNS Client for Humans | https://doggo.mrkaran.dev/ https://github.com/mr-karan/doggo
brew "gping" # Ping, but with a graph | https://github.com/orf/gping
brew "trippy" # Network diagnostic tool, inspired by mtr | https://trippy.rs/ https://github.com/fujiapple852/trippy
brew "iperf3" # Update of iperf: measures TCP, UDP, and SCTP bandwidth | https://github.com/esnet/iperf
brew "cloudflare-speed-cli" # Cloudflare-based speed test with optional TUI | https://github.com/kavehtehrani/cloudflare-speed-cli

# Tunnels
cask "ngrok" # Reverse proxy, secure introspectable tunnels to localhost | https://ngrok.com/
brew "cloudflared" # Cloudflare Tunnel client (formerly Argo Tunnel) | https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/ https://github.com/cloudflare/cloudflared

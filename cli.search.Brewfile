cask_args appdir: '/Applications', require_sha: true

brew 'ack' # Search tool like grep, but optimized for programmers | https://beyondgrep.com https://github.com/beyondgrep/ack3
brew 'fd' # Simple, fast and user-friendly alternative to find | https://github.com/sharkdp/fd
brew 'ripgrep' # Search tool like grep and The Silver Searcher | https://github.com/BurntSushi/ripgrep
brew 'the_silver_searcher' # Code-search similar to ack | https://geoff.greer.fm/ag/ https://github.com/ggreer/the_silver_searcher

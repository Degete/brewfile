cask_args appdir: "/Applications", require_sha: true

# cat
brew "bat" # Clone of cat(1) with syntax highlighting and Git integration | https://github.com/sharkdp/bat
brew "ccat" # Like cat but displays content with syntax highlighting | https://github.com/owenthereal/ccat

# ls / tree
brew "eza" # Modern, maintained replacement for ls | https://eza.rocks https://github.com/eza-community/eza
brew "lsd" # Clone of ls with colorful output, file type icons, and more | https://github.com/lsd-rs/lsd
brew "broot" # New way to see and navigate directory trees | https://dystroy.org/broot/ https://github.com/Canop/broot

# find / grep / sed
brew "fd" # Simple, fast and user-friendly alternative to find | https://github.com/sharkdp/fd
brew "ripgrep" # Search tool like grep and The Silver Searcher | https://github.com/BurntSushi/ripgrep
brew "ack" # Search tool like grep, but optimized for programmers | https://beyondgrep.com https://github.com/beyondgrep/ack3
brew "the_silver_searcher" # Code-search similar to ack | https://geoff.greer.fm/ag/ https://github.com/ggreer/the_silver_searcher
brew "sd" # Intuitive find & replace CLI | https://github.com/chmln/sd

# Fuzzy finders
brew "fzf" # Command-line fuzzy finder written in Go | https://junegunn.github.io/fzf/ https://github.com/junegunn/fzf
brew "sk" # Fuzzy Finder in rust! | https://github.com/skim-rs/skim

# du / df / ps
brew "dust" # More intuitive version of du in rust | https://github.com/bootandy/dust
brew "duf" # Disk Usage/Free Utility - a better 'df' alternative | https://github.com/muesli/duf
brew "procs" # Modern replacement for ps written in Rust | https://github.com/dalance/procs

cask_args appdir: '/Applications', require_sha: true

# Version control
brew 'git' # Distributed revision control system | https://git-scm.com https://github.com/git/git
brew 'git-lfs' # Git extension for versioning large files | https://git-lfs.com https://github.com/git-lfs/git-lfs
brew 'jj' # Git-compatible distributed version control system | https://github.com/jj-vcs/jj

# Extensions
brew 'git-extras' # Small git utilities | https://github.com/tj/git-extras
brew 'git-filter-repo' # Quickly rewrite git repository history | https://github.com/newren/git-filter-repo
brew 'pre-commit' # Framework for managing multi-language pre-commit hooks | https://pre-commit.com/ https://github.com/pre-commit/pre-commit

# Secrets
brew 'git-secrets' # Prevents you from committing sensitive information to a git repo | https://github.com/awslabs/git-secrets
brew 'gitleaks' # Audit git repos for secrets | https://gitleaks.io/ https://github.com/gitleaks/gitleaks

# Diffs
brew 'git-delta' # Syntax-highlighting pager for git and diff output | https://dandavison.github.io/delta/ https://github.com/dandavison/delta
brew 'diff-so-fancy' # Good-lookin' diffs with diff-highlight and more | https://github.com/so-fancy/diff-so-fancy
brew 'difftastic' # Diff that understands syntax | https://difftastic.wilfred.me.uk/ https://github.com/Wilfred/difftastic

# GitHub
brew 'gh' # GitHub command-line tool | https://cli.github.com https://github.com/cli/cli
brew 'hub' # Add GitHub support to git on the command-line | https://hub.github.com https://github.com/mislav/hub

# Clients
brew 'lazygit' # Simple terminal UI for git commands | https://github.com/jesseduffield/lazygit
brew 'gitui' # Blazing fast terminal-ui for git written in rust | https://github.com/gitui-org/gitui
brew 'tig' # Text interface for Git repositories | https://jonas.github.io/tig https://github.com/jonas/tig
cask 'fork' # GIT client | https://fork.dev https://git-fork.com

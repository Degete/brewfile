cask_args appdir: "/Applications", require_sha: true

# Terminal editors
brew "vim" # Vi 'workalike' with many additional features | https://www.vim.org/ https://github.com/vim/vim
brew "neovim" # Ambitious Vim-fork focused on extensibility and agility | https://neovim.io/ https://github.com/neovim/neovim
brew "tree-sitter-cli" # Parser generator tool | https://tree-sitter.github.io https://github.com/tree-sitter/tree-sitter
brew "helix" # Post-modern modal text editor | https://helix-editor.com https://github.com/helix-editor/helix
brew "eugenioenko/ttt/ttt", trusted: true # Terminal text editor | https://tttedit.dev https://github.com/eugenioenko/ttt
brew "tsuzuri" # Block-based Markdown notebook for the terminal | https://github.com/jaisuriya-11/tsuzuri
brew "vip" # Program that provides for interactive editing in a pipeline | https://users.cs.duke.edu/~des/vip.html

# GUI editors
brew "neovide" # No Nonsense Neovim Client in Rust | https://neovide.dev/ https://github.com/neovide/neovide
cask "visual-studio-code" # Open-source code editor | https://code.visualstudio.com https://github.com/microsoft/vscode
cask "cursor" # Write, edit, and chat about your code with AI | https://www.cursor.com/
cask "zed" # Multiplayer code editor | https://zed.dev/ https://github.com/zed-industries/zed

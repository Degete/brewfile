cask_args appdir: "/Applications", require_sha: true

# VPN
cask "tunnelblick" # Free and open-source OpenVPN client | https://tunnelblick.net/downloads.html https://github.com/Tunnelblick/Tunnelblick
cask "openvpn-connect" # Client program for the OpenVPN Access Server | https://openvpn.net/client-connect-vpn-for-mac-os/
cask "tailscale-app" # Mesh VPN based on WireGuard | https://tailscale.com/
mas "WireGuard", id: 1451685025 # Fast, modern and secure VPN tunnel client | https://apps.apple.com/app/id1451685025

# Ad blocking
cask "adguard" # Stand alone ad blocker | https://adguard.com/

# FTP/SFTP
cask "cyberduck" # Server and cloud storage browser | https://cyberduck.io https://github.com/iterate-ch/cyberduck
cask "jeffcaldwellca/tap/teleport-ftp", trusted: true # Native FTP, FTPS and SFTP client with the tport command-line tool built in | https://github.com/jeffcaldwellca/teleport

# File sharing & sync
cask "localsend" # Open-source cross-platform alternative to AirDrop | https://localsend.org/ https://github.com/localsend/localsend
cask "syncthing-app" # Real time file synchronisation software | https://syncthing.net/ https://github.com/syncthing/syncthing-macos

# Torrent
cask "transmission" # Open-source BitTorrent client | https://transmissionbt.com https://github.com/transmission/transmission

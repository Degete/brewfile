cask_args appdir: '/Applications', require_sha: true

# GPG
brew 'gnupg' # GNU Privacy Guard (OpenPGP) | https://gnupg.org/ https://github.com/gpg/gnupg
brew 'gpg-tui' # Manage your GnuPG keys with ease! | https://github.com/orhun/gpg-tui
brew 'pinentry-mac' # Pinentry for GPG on Mac | https://github.com/GPGTools/pinentry

# Passwords
cask '1password-cli' # Command-line interface for 1Password | https://www.1password.dev/cli

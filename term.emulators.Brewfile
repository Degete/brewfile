cask_args appdir: "/Applications", require_sha: true

# INFO: ghostty and ghostty@tip conflict, install only one of them
cask "ghostty" # Terminal emulator that uses platform-native UI and GPU acceleration | https://ghostty.org/ https://github.com/ghostty-org/ghostty
cask "ghostty@tip" # Terminal emulator that uses platform-native UI and GPU acceleration | https://ghostty.org/
cask "cmux" # Ghostty-based terminal with vertical tabs and notifications for AI coding agents | https://cmux.com/ https://github.com/manaflow-ai/cmux
cask "iterm2" # Terminal emulator as alternative to Apple's Terminal app | https://iterm2.com https://github.com/gnachman/iTerm2
cask "kitty" # GPU-based terminal emulator | https://sw.kovidgoyal.net/kitty/ https://github.com/kovidgoyal/kitty
cask "warp" # Rust-based terminal | https://www.warp.dev/
cask "wezterm" # GPU-accelerated cross-platform terminal emulator and multiplexer | https://wezterm.org/ https://github.com/wezterm/wezterm
brew "rio-terminal" # Hardware-accelerated GPU terminal emulator powered by WebGPU | https://rioterm.com/ https://github.com/raphamorim/rio

cask_args appdir: "/Applications", require_sha: true

# Version manager (all languages: alternative to pyenv, rbenv, nvm, fnm...)
brew "mise" # Polyglot runtime manager (asdf rust clone) | https://mise.jdx.dev/ https://github.com/jdx/mise

# C
brew "cmake" # Cross-platform make | https://cmake.org https://gitlab.kitware.com/cmake/cmake https://github.com/Kitware/CMake
brew "llvm" # Next-gen compiler infrastructure | https://llvm.org https://github.com/llvm/llvm-project
brew "gcc" # GNU compiler collection | https://gcc.gnu.org https://gcc.gnu.org/git/gcc.git
brew "gdb" # GNU debugger | https://www.gnu.org/software/gdb https://sourceware.org/git/binutils-gdb.git

# Lua
brew "lua" # Powerful, lightweight programming language | https://www.lua.org/
brew "luarocks" # Package manager for the Lua programming language | https://luarocks.org/ https://github.com/luarocks/luarocks

# Python
brew "python" # Interpreted, interactive, object-oriented programming language | https://www.python.org https://github.com/python/cpython
brew "pyenv" # Python version management | https://github.com/pyenv/pyenv
brew "pipenv" # Python dependency management tool | https://pipenv.pypa.io https://github.com/pypa/pipenv
brew "poetry" # Python package management tool | https://python-poetry.org https://github.com/python-poetry/poetry
brew "uv" # Extremely fast Python package installer and resolver, written in Rust | https://docs.astral.sh/uv/ https://github.com/astral-sh/uv
brew "pipx" # Execute binaries from Python packages in isolated environments | https://pipx.pypa.io https://github.com/pypa/pipx
brew "black" # Python code formatter | https://black.readthedocs.io https://github.com/psf/black
brew "ruff" # Extremely fast Python linter and code formatter, written in Rust | https://docs.astral.sh/ruff/ https://github.com/astral-sh/ruff

# PHP
brew "php" # General-purpose scripting language | https://www.php.net https://github.com/php/php-src
brew "composer" # Dependency Manager for PHP | https://getcomposer.org https://github.com/composer/composer

# NodeJS
brew "node" # Open-source, cross-platform JavaScript runtime environment | https://nodejs.org https://github.com/nodejs/node
brew "nvm" # Manage multiple Node.js versions | https://github.com/nvm-sh/nvm
brew "fnm" # Fast and simple Node.js version manager | https://github.com/Schniz/fnm
brew "bun" # Incredibly fast JavaScript runtime, bundler, test runner, and package manager | https://bun.com/ https://github.com/oven-sh/bun
brew "deno" # Secure runtime for JavaScript and TypeScript | https://deno.com/ https://github.com/denoland/deno
brew "pnpm" # Fast, disk space efficient package manager | https://pnpm.io/ https://github.com/pnpm/pnpm

# .NET
cask "dotnet-sdk" # Developer platform | https://www.microsoft.com/net/core#macos

# Java
cask "temurin" # JDK from the Eclipse Foundation (Adoptium) | https://adoptium.net/temurin/ https://github.com/adoptium/temurin27-binaries

# Go
brew "go" # Open source programming language to build simple/reliable/efficient software | https://go.dev/doc/ https://github.com/golang/go

# Kotlin
brew "kotlin" # Statically typed programming language for the JVM | https://kotlinlang.org https://github.com/JetBrains/kotlin
cask "kotlin-lsp" # Official Kotlin Language Server | https://github.com/Kotlin/kotlin-lsp

# Ruby
brew "ruby" # Powerful, clean, object-oriented scripting language | https://www.ruby-lang.org https://github.com/ruby/ruby
brew "rbenv" # Ruby version manager | https://rbenv.org https://github.com/rbenv/rbenv

# Rust
brew "rustup" # Rust toolchain installer | https://www.rust-lang.org https://rust-lang.github.io/rustup https://github.com/rust-lang/rustup
brew "rust-analyzer" # Experimental Rust compiler front-end for IDEs | https://rust-analyzer.github.io https://github.com/rust-lang/rust-analyzer
# INFO: rust installs a fixed toolchain, rustup manages toolchains (prefer one of them)
brew "rust" # Safe, concurrent, practical language | https://www.rust-lang.org/ https://github.com/rust-lang/rust

# Shellscript
brew "shellcheck" # Static analysis and lint tool, for (ba)sh scripts | https://www.shellcheck.net https://github.com/koalaman/shellcheck
brew "shfmt" # Autoformat shell script source code | https://github.com/mvdan/sh

# YAML
brew "yamllint" # Linter for YAML files | https://github.com/adrienverge/yamllint

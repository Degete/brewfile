cask_args appdir: "/Applications", require_sha: true

# Code
brew "universal-ctags" # Maintained ctags implementation | https://ctags.io/ https://github.com/universal-ctags/ctags
brew "tokei" # Program that allows you to count code, quickly | https://github.com/XAMPPRocky/tokei

# Task runners & environment
brew "just" # Handy way to save and run project-specific commands | https://just.systems https://github.com/casey/just
brew "direnv" # Load/unload environment variables based on $PWD | https://direnv.net/ https://github.com/direnv/direnv
brew "mkcert" # Simple tool to make locally trusted development certificates | https://github.com/FiloSottile/mkcert

# File watchers
brew "watchman" # Watch files and take action when they change | https://facebook.github.io/watchman/ https://github.com/facebook/watchman
brew "fswatch" # Monitor a directory for changes and run a shell command | https://emcrisostomo.github.io/fswatch/ https://github.com/emcrisostomo/fswatch

# Benchmarking & load testing
brew "hyperfine" # Command-line benchmarking tool | https://github.com/sharkdp/hyperfine
brew "wrk" # HTTP benchmarking tool | https://github.com/wg/wrk
brew "k6" # Modern load testing tool, using Go and JavaScript | https://k6.io https://github.com/grafana/k6

# Browser testing
brew "geckodriver" # WebDriver <-> Marionette proxy | https://firefox-source-docs.mozilla.org/testing/geckodriver/ https://github.com/mozilla/geckodriver

cask_args appdir: '/Applications', require_sha: true

brew 'boxes' # Draw boxes around text | https://boxes.thomasjensen.com https://github.com/ascii-boxes/boxes
brew 'chafa' # Versatile and fast Unicode/ASCII/ANSI graphics renderer | https://hpjansson.org/chafa/ https://github.com/hpjansson/chafa
brew 'lolcat' # Rainbows and unicorns in your console! | https://github.com/busyloop/lolcat
brew 'figlet' # Banner-like program prints strings as ASCII art | http://www.figlet.org/
brew 'fortune' # Infamous electronic fortune-cookie generator | https://www.ibiblio.org/pub/linux/games/amusements/fortune/!INDEX.html
brew 'toilet' # Color-based alternative to figlet (uses libcaca) | http://caca.zoy.org/wiki/toilet https://github.com/cacalabs/toilet

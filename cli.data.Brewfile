cask_args appdir: '/Applications', require_sha: true

# JSON / YAML
brew 'jq' # Lightweight and flexible command-line JSON processor | https://jqlang.org/ https://github.com/jqlang/jq
brew 'yq' # Process YAML, JSON, XML, CSV and properties documents from the CLI | https://github.com/mikefarah/yq

# Documents
brew 'pandoc' # Swiss-army knife of markup format conversion | https://pandoc.org/ https://github.com/jgm/pandoc
brew 'poppler' # PDF rendering library (based on the xpdf-3.0 code base) | https://poppler.freedesktop.org/
brew 'ghostscript' # Interpreter for PostScript and PDF | https://www.ghostscript.com/ https://github.com/ArtifexSoftware/ghostpdl-downloads
brew 'glow' # Render markdown on the CLI | https://github.com/charmbracelet/glow
brew 'highlight' # Convert source code to formatted text with syntax highlighting | http://www.andre-simon.de/doku/highlight/highlight.php
brew 'translate-shell' # Command-line translator using Google Translate and more | https://www.soimort.org/translate-shell https://github.com/soimort/translate-shell

# Images
brew 'imagemagick' # Tools and libraries to manipulate images in select formats | https://imagemagick.org https://github.com/ImageMagick/ImageMagick

# Viewers
brew 'lnav' # Curses-based tool for viewing and analyzing log files | https://lnav.org/ https://github.com/tstack/lnav
brew 'hexyl' # Command-line hex viewer | https://github.com/sharkdp/hexyl

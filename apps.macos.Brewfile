cask_args appdir: '/Applications', require_sha: true

brew 'm-cli' # Swiss Army Knife for macOS | https://github.com/rgcr/m-cli

# QuickLook plugins | https://github.com/sindresorhus/quick-look-plugins https://www.quicklookplugins.com/
# macOS > Catalina need to remove the quarantine attributes
# Check attributes: xattr -r ~/Library/QuickLook
# Remove attributes: xattr -d -r com.apple.quarantine ~/Library/QuickLook
# Restart QuickLook manager: qlmanage -r
cask 'quicklook-video' # Thumbnails, static previews, cover art and metadata for video files | https://github.com/Marginal/QuickLookVideo
cask 'syntax-highlight' # Quicklook extension for source files | https://github.com/sbarex/SourceCodeSyntaxHighlight
cask 'suspicious-package' # Application for inspecting installer packages | https://mothersruin.com/software/SuspiciousPackage/
cask 'apparency' # Inspect application bundles | https://www.mothersruin.com/software/Apparency/
cask 'archaeology', args: { require_sha: false } # Tool for digging into binary files | https://mothersruin.com/software/Archaeology/

# Launchers
cask 'raycast' # Control your tools with a few keystrokes | https://www.raycast.com
cask 'abue-ammar/tinycast/tinycast', trusted: true # Tiny, fully native launcher, hotkeys, and clipboard history | https://github.com/abue-ammar/tinycast

# Screensaver
cask 'aerial' # Apple TV Aerial screensaver | https://aerialscreensaver.github.io/ https://github.com/AerialScreensaver/Aerial

# Monitoring
cask 'stats' # System monitor for the menu bar | https://github.com/exelban/stats

# Calendar
cask 'itsycal' # Menu bar calendar | https://www.mowglii.com/itsycal/

# Utilities
cask 'appcleaner' # Application uninstaller | https://freemacsoft.net/appcleaner
cask 'purge' # Clears caches and junk files by moving them to the Trash | https://purgemac.com/ https://github.com/jithin-sabu/purge-app
cask 'karabiner-elements' # Keyboard customiser | https://karabiner-elements.pqrs.org https://github.com/pqrs-org/Karabiner-Elements
cask 'hyperkey' # Convert your caps lock key or any of your modifier keys to the hyper key | https://hyperkey.app/
cask 'hammerspoon' # Desktop automation application | https://www.hammerspoon.org/ https://github.com/Hammerspoon/hammerspoon
cask 'betterdisplay' # Display management tool | https://betterdisplay.pro/ https://github.com/waydabber/BetterDisplay
cask 'finetune' # Per-application volume mixer, equalizer, and audio router | https://github.com/ronitsingh10/FineTune
cask 'adguard' # Stand alone ad blocker | https://adguard.com/
cask 'easydict' # Dictionary and translator app | https://github.com/tisfeng/Easydict/
cask 'openwhispr' # Privacy-first voice-to-text dictation with AI agents | https://github.com/OpenWhispr/openwhispr
cask 'ukelele' # Unicode keyboard layout editor | https://software.sil.org/ukelele/
mas 'Amphetamine', id: 937984704 # Keep your Mac and its displays awake | https://apps.apple.com/app/id937984704

# Menu bar
cask 'jordanbaird-ice' # Menu bar manager | https://icemenubar.app/ https://github.com/jordanbaird/Ice
cask 'thaw' # Menu bar manager | https://github.com/thaw-app/Thaw/

# Notch
cask 'atoll' # Dynamic Island for the MacBook notch | https://getatoll.app/ https://github.com/Ebullioscopic/Atoll
cask 'theboredteam/boring-notch/boring-notch', trusted: true # Not so boring notch That Rocks | https://github.com/TheBoredTeam/boring.notch

# Window management
cask 'rectangle' # Move and resize windows using keyboard shortcuts or snap areas | https://rectangleapp.com https://github.com/rxhanson/Rectangle
cask 'tiles' # Window manager | https://freemacsoft.net/tiles/ https://www.sempliva.com/tiles/
cask 'amethyst' # Automatic tiling window manager similar to xmonad | https://ianyh.com/amethyst/ https://github.com/ianyh/Amethyst
cask 'loop' # Window manager | https://github.com/MrKai77/Loop
tap 'koekeishiya/formulae', trusted: true # Homebrew tap for yabai and skhd | https://github.com/asmvik/homebrew-formulae
brew 'koekeishiya/formulae/yabai', trusted: true # Tiling window manager for macOS | https://github.com/asmvik/yabai
brew 'koekeishiya/formulae/skhd', trusted: true # Simple hotkey daemon for macOS | https://github.com/asmvik/skhd

# Clipboard management
cask 'maccy' # Clipboard manager | https://maccy.app https://github.com/p0deje/Maccy
cask 'momenbasel/pesty/pesty', trusted: true # Free, open-source clipboard manager inspired by Paste | https://github.com/momenbasel/pesty

# VPN
cask 'tunnelblick' # Free and open-source OpenVPN client | https://tunnelblick.net/downloads.html https://github.com/Tunnelblick/Tunnelblick
cask 'openvpn-connect' # Client program for the OpenVPN Access Server | https://openvpn.net/client-connect-vpn-for-mac-os/
cask 'tailscale-app' # Mesh VPN based on WireGuard | https://tailscale.com/
mas 'WireGuard', id: 1451685025 # Fast, modern and secure VPN tunnel client | https://apps.apple.com/app/id1451685025

# Disk images
cask 'balenaetcher' # Tool to flash OS images to SD cards & USB drives | https://etcher.balena.io/ https://github.com/balena-io/etcher
cask 'raspberry-pi-imager' # Imaging utility to install operating systems to a microSD card | https://www.raspberrypi.com/software/ https://github.com/raspberrypi/rpi-imager
cask 'crystalfetch' # UI for creating Windows installer ISO from UUPDump | https://github.com/TuringSoftware/CrystalFetch

# File archiver
cask 'keka' # File archiver | https://www.keka.io https://github.com/aonez/Keka
cask 'kekaexternalhelper' # Helper application for the Keka file archiver | https://github.com/aonez/Keka/wiki/Default-application

# Image processing
cask 'imageoptim' # Tool to optimise images to a smaller size | https://imageoptim.com/mac https://github.com/ImageOptim/ImageOptim

# Screenshots
cask 'shottr' # Screenshot measurement and annotation tool | https://shottr.cc/

# Presentation
cask 'keycastr' # Open-source keystroke visualiser | https://github.com/keycastr/keycastr

# Notes
cask 'obsidian' # Knowledge base that works on top of a local folder of plain text Markdown files | https://obsidian.md/ https://github.com/obsidianmd/obsidian-releases

# Passwords
cask '1password' # Password manager that keeps all passwords secure behind one password | https://1password.com/
cask '1password-cli' # Command-line interface for 1Password | https://www.1password.dev/cli

# FTP/SFTP
cask 'cyberduck' # Server and cloud storage browser | https://cyberduck.io https://github.com/iterate-ch/cyberduck
cask 'jeffcaldwellca/tap/teleport-ftp', trusted: true # Native FTP, FTPS and SFTP client with the tport command-line tool built in | https://github.com/jeffcaldwellca/teleport


# Torrent
cask 'transmission' # Open-source BitTorrent client | https://transmissionbt.com https://github.com/transmission/transmission

# Languages
cask 'anki' # Memory training application | https://apps.ankiweb.net https://github.com/ankitects/anki

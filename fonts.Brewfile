cask_args appdir: "/Applications", require_sha: true

# Nerd Font symbols only (terminals like Ghostty, Kitty and WezTerm can use it as fallback for icons with any font)
cask "font-symbols-only-nerd-font" # Nerd Font icons only | https://github.com/ryanoasis/nerd-fonts

# Departure Mono
cask "font-departure-mono" # Departure Mono font | https://github.com/rektdeckard/departure-mono
cask "font-departure-mono-nerd-font" # Departure Mono font patched with Nerd Font icons | https://github.com/ryanoasis/nerd-fonts

# Fira Code
cask "font-fira-code" # Fira Code font | https://github.com/tonsky/FiraCode
cask "font-fira-code-nerd-font" # Fira Code font patched with Nerd Font icons | https://github.com/ryanoasis/nerd-fonts
cask "font-fira-mono", args: { require_sha: false } # Fira Mono font | https://fonts.google.com/specimen/Fira+Mono https://github.com/mozilla/Fira
cask "font-fira-mono-nerd-font" # Fira Mono font patched with Nerd Font icons | https://github.com/ryanoasis/nerd-fonts

# Hack
cask "font-hack" # Hack font | https://sourcefoundry.org/hack/ https://github.com/source-foundry/Hack
cask "font-hack-nerd-font" # Hack font patched with Nerd Font icons | https://github.com/ryanoasis/nerd-fonts

# JetBrains
cask "font-jetbrains-mono" # Jetbrains Mono font | https://www.jetbrains.com/lp/mono/ https://github.com/JetBrains/JetBrainsMono
cask "font-jetbrains-mono-nerd-font" # Jetbrains Mono font patched with Nerd Font icons | https://github.com/ryanoasis/nerd-fonts

# SourceCodePro
cask "font-source-code-pro", args: { require_sha: false } # Source Code Pro font | https://adobe-fonts.github.io/source-code-pro/ https://fonts.google.com/specimen/Source+Code+Pro https://github.com/adobe-fonts/source-code-pro
cask "font-sauce-code-pro-nerd-font" # Sauce Code Pro font patched with Nerd Font icons | https://github.com/ryanoasis/nerd-fonts

# Maple Mono
cask "font-maple-mono" # Maple Mono font | https://font.subf.dev/en/ https://github.com/subframe7536/maple-font

# Monaspace
cask "font-monaspace" # Monaspace font family | https://monaspace.githubnext.com/ https://github.com/githubnext/monaspace

# Terminus
cask "font-terminess-ttf-nerd-font" # Terminess TTF font patched with Nerd Font icons | https://terminus-font.sourceforge.net https://github.com/ryanoasis/nerd-fonts

# Victor Mono
cask "font-victor-mono", args: { require_sha: false } # Victor Mono font | https://rubjo.github.io/victor-mono/ https://github.com/rubjo/victor-mono
cask "font-victor-mono-nerd-font" # Victor Mono font patched with Nerd Font icons | https://github.com/ryanoasis/nerd-fonts

cask_args appdir: '/Applications', require_sha: true

# GNU tools (macOS ships BSD or old versions)
# INFO: findutils, grep, gnu-tar and make install their commands with a `g` prefix (gfind, ggrep, gtar, gmake)
brew 'coreutils' # GNU File, Shell, and Text utilities | https://www.gnu.org/software/coreutils/
brew 'findutils' # Collection of GNU find, xargs, and locate | https://www.gnu.org/software/findutils/
brew 'gawk' # GNU awk utility | https://www.gnu.org/software/gawk/
brew 'gnu-sed' # GNU implementation of the famous stream editor | https://www.gnu.org/software/sed/
brew 'gnu-tar' # GNU version of the tar archiving utility | https://www.gnu.org/software/tar/
brew 'grep' # GNU grep, egrep and fgrep | https://www.gnu.org/software/grep/
brew 'make' # Utility for directing compilation | https://www.gnu.org/software/make/
brew 'rsync' # Utility that provides fast incremental file transfer | https://rsync.samba.org/ https://github.com/RsyncProject/rsync

# Network
brew 'curl' # Get a file from an HTTP, HTTPS or FTP server | https://curl.se https://github.com/curl/curl
brew 'wget' # Internet file retriever | https://www.gnu.org/software/wget/
brew 'openssl' # Cryptography and SSL/TLS Toolkit | https://openssl-library.org https://github.com/openssl/openssl

# Archives
brew 'xz' # General-purpose data compression with high compression ratio | https://tukaani.org/xz/ https://github.com/tukaani-project/xz
brew 'sevenzip' # 7-Zip is a file archiver with a high compression ratio | https://7-zip.org https://github.com/ip7z/7zip
brew 'unar' # Command-line unarchiving tools supporting multiple formats | https://theunarchiver.com/command-line https://github.com/MacPaw/XADMaster

# Utilities
brew 'base64' # Encode and decode base64 files | https://www.fourmilab.ch/webtools/base64/
brew 'moreutils' # Collection of tools that nobody wrote when UNIX was young | https://joeyh.name/code/moreutils/
brew 'pv' # Monitor data's progress through a pipe | https://www.ivarch.com/programs/pv.shtml
brew 'tree' # Display directories as trees (with optional color/HTML output) | https://oldmanprogrammer.net/source.php?dir=projects/tree https://github.com/Old-Man-Programmer/tree
brew 'watch' # Executes a program periodically, showing output fullscreen | https://gitlab.com/procps-ng/procps

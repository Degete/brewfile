cask_args appdir: '/Applications', require_sha: true

brew 'postgresql' # Object-relational database system | https://www.postgresql.org https://github.com/postgres/postgres
brew 'redis' # Persistent key-value database, with built-in net interface | https://redis.io https://github.com/redis/redis
brew 'sqlite' # Command-line interface for SQLite | https://www.sqlite.org https://github.com/sqlite/sqlite
brew 'mysql' # Open source relational database management system | https://www.mysql.com https://github.com/mysql/mysql-server
brew 'mongosh' # MongoDB Shell to connect, configure, query, and work with your MongoDB database | https://www.mongodb.com/try/download/shell https://github.com/mongodb-js/mongosh
brew 'pgcli' # CLI for Postgres with auto-completion and syntax highlighting | https://www.pgcli.com
brew 'mycli' # CLI for MySQL with auto-completion and syntax highlighting | https://www.mycli.net https://github.com/dbcli/mycli

cask 'tableplus' # Native GUI tool for relational databases | https://tableplus.com
cask 'alpcanaydin/tusk/tusk', trusted: true # Fast, native, keyboard-driven database client | https://github.com/alpcanaydin/tusk

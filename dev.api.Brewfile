cask_args appdir: '/Applications', require_sha: true

cask 'postman' # Collaboration platform for API development | https://www.postman.com
cask 'insomnia' # HTTP and GraphQL Client | https://insomnia.rest https://github.com/Kong/insomnia
cask 'bruno' # Open source IDE for exploring and testing APIs | https://www.usebruno.com/ https://github.com/usebruno/bruno
brew 'hurl' # Run and Test HTTP Requests with plain text and curl | https://hurl.dev https://github.com/Orange-OpenSource/hurl
brew 'xh' # Friendly and fast tool for sending HTTP requests | https://github.com/ducaale/xh
brew 'openapi-generator' # Generate clients, server & docs from an OpenAPI spec (v2, v3) | https://openapi-generator.tech/ https://github.com/OpenAPITools/openapi-generator

# GRPC
brew 'grpcurl' # Like cURL, but for gRPC | https://github.com/fullstorydev/grpcurl
brew 'grpcui' # Interactive web UI for gRPC, along the lines of postman | https://github.com/fullstorydev/grpcui

# HTTP debugging proxies
cask 'proxyman' # HTTP debugging proxy | https://proxyman.com/ https://github.com/ProxymanApp/Proxyman
cask 'mitmproxy' # Intercept, modify, replay, save HTTP/S traffic | https://mitmproxy.org/ https://github.com/mitmproxy/mitmproxy

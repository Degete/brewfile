cask_args appdir: '/Applications', require_sha: true

cask 'google-chrome', args: { require_sha: false } # Web browser | https://www.google.com/chrome/
cask 'firefox' # Web browser | https://www.firefox.com/
cask 'firefox@developer-edition' # Web browser | https://www.firefox.com/channel/desktop/developer/
brew 'geckodriver' # WebDriver <-> Marionette proxy | https://firefox-source-docs.mozilla.org/testing/geckodriver/ https://github.com/mozilla/geckodriver
cask 'vivaldi' # Web browser with built-in email client focusing on customization and control | https://vivaldi.com
cask 'arc' # Chromium based browser | https://arc.net/

# Safari extensions
mas 'Noir – Dark Mode for Safari', id: 1592917505 # Safari extension that adds a dark mode to every website | https://apps.apple.com/app/id1592917505

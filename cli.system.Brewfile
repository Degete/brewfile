cask_args appdir: "/Applications", require_sha: true

# Monitoring
brew "htop" # Improved top (interactive process viewer) | https://htop.dev https://github.com/htop-dev/htop
brew "bottom" # Yet another cross-platform graphical process/system monitor | https://clementtsang.github.io/bottom/ https://github.com/ClementTsang/bottom
brew "btop" # Resource monitor. C++ version and continuation of bashtop and bpytop | https://github.com/aristocratos/btop

# System info
brew "macchina" # System information fetcher, with an emphasis on performance and minimalism | https://github.com/Macchina-CLI/macchina
brew "fastfetch" # Like neofetch, but much faster because written mostly in C | https://github.com/fastfetch-cli/fastfetch

# macOS
brew "m-cli" # Swiss Army Knife for macOS | https://github.com/rgcr/m-cli
brew "blueutil" # Get/set bluetooth power and discoverable state | https://github.com/toy/blueutil
brew "duti" # Select default apps for documents and URL schemes on macOS | https://github.com/moretension/duti/
brew "mole" # Deep clean and optimize your Mac | https://mole.fit https://github.com/tw93/Mole

# Maintenance & help
brew "topgrade" # Upgrade all the things | https://github.com/topgrade-rs/topgrade
brew "tlrc" # Official tldr client written in Rust | https://tldr.sh/tlrc/ https://github.com/tldr-pages/tlrc

cask_args appdir: "/Applications", require_sha: true

# Stores & launchers
cask "steam", args: { require_sha: false } # Video game digital distribution service | https://store.steampowered.com/about/
cask "heroic" # Game launcher | https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/
cask "sony-ps-remote-play", args: { require_sha: false } # Application to control your PlayStation 4 or PlayStation 5 | https://remoteplay.dl.playstation.net/remoteplay/lang/en/

# Emulators
cask "retroarch", args: { require_sha: false } # Frontend for emulators, game engines and media players (OpenGL graphics API) | https://www.retroarch.com/
cask "es-de" # Frontend for browsing and launching games from your multi-platform collection | https://www.es-de.org/
cask "pcsx2" # Playstation 2 Emulator | https://pcsx2.net/ https://github.com/PCSX2/pcsx2
brew "dosbox-x" # DOSBox with accurate emulation and wide testing | https://dosbox-x.com/ https://github.com/joncampbell123/dosbox-x

# Controllers
cask "8bitdo-ultimate-software-v2" # Control every piece of your controller | https://app.8bitdo.com/Ultimate-Software-V2/
cask "8bitdo-firmware-updater" # Firmware updater for 8BitDo controllers | https://support.8bitdo.com/firmware-updater.html

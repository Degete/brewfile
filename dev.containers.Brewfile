cask_args appdir: "/Applications", require_sha: true

# Runtimes
# INFO: docker-desktop, orbstack and colima all provide a Docker engine, usually only one of them is needed
cask "docker-desktop" # App to build and share containerised applications and microservices | https://www.docker.com https://github.com/docker
cask "orbstack" # Replacement for Docker Desktop | https://orbstack.dev/ https://github.com/orbstack/orbstack
brew "colima" # Container runtimes on MacOS (and Linux) with minimal setup | https://colima.run https://github.com/abiosoft/colima
brew "container" # Create and run Linux containers using lightweight virtual machines | https://apple.github.io/container/documentation/ https://github.com/apple/container

# Docker tools
brew "lazydocker" # Lazier way to manage everything docker | https://github.com/jesseduffield/lazydocker
brew "dive" # Tool for exploring each layer in a docker image | https://github.com/wagoodman/dive
brew "hadolint" # Smarter Dockerfile linter to validate best practices | https://github.com/hadolint/hadolint
brew "trivy" # Vulnerability scanner for container images, file systems, and Git repos | https://trivy.dev/ https://github.com/aquasecurity/trivy

# Kubernetes
brew "kubernetes-cli" # Kubernetes command-line interface | https://kubernetes.io https://github.com/kubernetes/kubernetes
brew "kubectx" # Tool that can switch between kubectl contexts easily and create aliases | https://github.com/ahmetb/kubectx
brew "k9s" # Kubernetes CLI To Manage Your Clusters In Style! | https://k9scli.io https://github.com/derailed/k9s
brew "nklmilojevic/sofka/sofka", trusted: true # Kubernetes TUI, reimagined in Rust | https://github.com/nklmilojevic/sofka
brew "minikube" # Run a Kubernetes cluster locally | https://minikube.sigs.k8s.io/docs/ https://github.com/kubernetes/minikube
brew "kind" # Run local Kubernetes cluster in Docker | https://kind.sigs.k8s.io/ https://github.com/kubernetes-sigs/kind
brew "kompose" # Tool to move from `docker-compose` to Kubernetes | https://kompose.io https://github.com/kubernetes/kompose
brew "kustomize" # Template-free customization of Kubernetes YAML manifests | https://kustomize.io https://github.com/kubernetes-sigs/kustomize
brew "helm" # Kubernetes package manager | https://helm.sh https://github.com/helm/helm
brew "helmfile" # Deploy Kubernetes Helm Charts | https://github.com/helmfile/helmfile
brew "stern" # Tail multiple Kubernetes pods & their containers | https://github.com/stern/stern
brew "krew" # Package manager for kubectl plugins | https://krew.sigs.k8s.io/ https://github.com/kubernetes-sigs/krew

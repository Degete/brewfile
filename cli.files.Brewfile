cask_args appdir: '/Applications', require_sha: true

# File managers
brew 'vifm' # Ncurses-based file manager with vi-like keybindings | https://vifm.info/ https://github.com/vifm/vifm
brew 'xplr' # Hackable, minimal, fast TUI file explorer | https://xplr.dev https://github.com/sayanarijit/xplr
brew 'yazi' # Blazing fast terminal file manager written in Rust, based on async I/O | https://yazi-rs.github.io https://github.com/sxyazi/yazi

# Sync, transfer & backup
brew 'chezmoi' # Manage your dotfiles across multiple diverse machines, securely | https://chezmoi.io/ https://github.com/twpayne/chezmoi
brew 'rclone' # Rsync for cloud storage | https://rclone.org/ https://github.com/rclone/rclone
brew 'croc' # Securely send things from one computer to another | https://github.com/schollz/croc
brew 'restic' # Fast, efficient and secure backup program | https://restic.net/ https://github.com/restic/restic

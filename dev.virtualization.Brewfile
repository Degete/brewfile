cask_args appdir: '/Applications', require_sha: true

cask 'virtualbox' # Virtualiser for arm64 hardware | https://www.virtualbox.org
brew 'qemu' # Generic machine emulator and virtualizer | https://www.qemu.org https://github.com/qemu/qemu
cask 'utm' # Virtual machines UI using QEMU | https://getutm.app https://github.com/utmapp/UTM

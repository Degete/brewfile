cask_args appdir: "/Applications", require_sha: true

# Reverse engineering
brew "radare2" # Reverse engineering framework | https://www.radare.org/ https://github.com/radareorg/radare2
cask "cutter" # Reverse engineering platform powered by Rizin | https://cutter.re https://github.com/rizinorg/cutter
brew "ghidra" # Multi-platform software reverse engineering framework | https://ghidra-sre.org https://github.com/NationalSecurityAgency/ghidra
cask "hex-fiend" # Hex editor focussing on speed | https://hexfiend.com/ https://github.com/HexFiend/HexFiend
cask "archaeology", args: { require_sha: false } # Tool for digging into binary files | https://mothersruin.com/software/Archaeology/

# Password cracking
brew "hashcat" # World's fastest and most advanced password recovery utility | https://hashcat.net/hashcat/ https://github.com/hashcat/hashcat
brew "crunch" # Wordlist generator | https://sourceforge.net/projects/crunch-wordlist/

# WiFi
brew "aircrack-ng" # Next-generation aircrack with lots of new features | https://aircrack-ng.org/
brew "hcxtools" # Utils for conversion of cap/pcap/pcapng WiFi dump files | https://github.com/ZerBea/hcxtools

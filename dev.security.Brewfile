cask_args appdir: '/Applications', require_sha: true

# Password cracking
brew 'hashcat' # World's fastest and most advanced password recovery utility | https://hashcat.net/hashcat/ https://github.com/hashcat/hashcat
brew 'crunch' # Wordlist generator | https://sourceforge.net/projects/crunch-wordlist/

# WiFi
brew 'aircrack-ng' # Next-generation aircrack with lots of new features | https://aircrack-ng.org/
brew 'hcxtools' # Utils for conversion of cap/pcap/pcapng WiFi dump files | https://github.com/ZerBea/hcxtools

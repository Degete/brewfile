cask_args appdir: '/Applications', require_sha: true

brew 'mpv' # Media player based on MPlayer and mplayer2 | https://mpv.io https://github.com/mpv-player/mpv
brew 'musikcube' # Terminal-based audio engine, library, player and server | https://musikcube.com https://github.com/clangen/musikcube
brew 'termusic' # Music Player TUI written in Rust | https://github.com/tramhao/termusic
brew 'ncmpc' # Curses Music Player Daemon (MPD) client | https://www.musicpd.org/clients/ncmpc/
brew 'pystardust/ani-cli/ani-cli', trusted: true # Cli tool to browse and play anime | https://github.com/pystardust/ani-cli
brew 'ffmpeg' # Play, record, convert, and stream select audio and video codecs | https://ffmpeg.org/ https://github.com/FFmpeg/FFmpeg
brew 'exiftool' # Perl lib for reading and writing EXIF metadata | https://exiftool.org

cask_args appdir: '/Applications', require_sha: true

# Shells
brew 'bash' # Bourne-Again SHell, a UNIX command interpreter | https://www.gnu.org/software/bash/
brew 'bash-completion@2' # Programmable completion for Bash 4.2+ | https://github.com/scop/bash-completion
# INFO: Need to add `$(brew --prefix)/bin/fish` to `/etc/shells`
brew 'fish' # User-friendly command-line shell for UNIX-like operating systems | https://fishshell.com https://github.com/fish-shell/fish-shell
# INFO: Need to add `$(brew --prefix)/bin/zsh` to `/etc/shells`
brew 'zsh' # UNIX shell (command interpreter) | https://www.zsh.org https://github.com/zsh-users/zsh
brew 'nushell' # Modern shell for the GitHub era | https://www.nushell.sh https://github.com/nushell/nushell

# Shell extensions
brew 'sheldon' # Fast, configurable, shell plugin manager | https://sheldon.cli.rs https://github.com/rossmacarthur/sheldon
brew 'starship' # Cross-shell prompt for astronauts | https://starship.rs/ https://github.com/starship/starship
brew 'zoxide' # Shell extension to navigate your filesystem faster | https://github.com/ajeetdsouza/zoxide
brew 'atuin' # Improved shell history for zsh, bash, fish and nushell | https://atuin.sh/ https://github.com/atuinsh/atuin

# Multiplexers
brew 'tmux' # Terminal multiplexer | https://tmux.github.io/ https://github.com/tmux/tmux
brew 'zellij' # Pluggable terminal workspace, with terminal multiplexer as the base feature | https://zellij.dev/ https://github.com/zellij-org/zellij
